# Tankerkönig-API-Key (kostenlos): https://creativecommons.tankerkoenig.de
# Ohne Key läuft die App im Demo-Modus mit simulierten Preisen.
TANKERKOENIG_API_KEY=

# Claude-API-Key für die KI-Analyse: https://platform.claude.com
# Ohne Key gibt es nur die statistische Empfehlung.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# PORT=3000
# HOST=127.0.0.1
# Abfrageintervall in Minuten (Tankerkönig erlaubt höchstens alle 5 Minuten)
# POLL_MINUTES=10
# Zeitzone für die Auswertung
# TZ_NAME=Europe/Berlin
